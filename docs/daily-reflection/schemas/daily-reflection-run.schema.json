{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inspirit.local/schemas/daily-reflection-run.schema.json",
  "title": "DailyReflectionRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_date",
    "time_window",
    "summary",
    "discernment_layers",
    "signals",
    "truth_mapping",
    "writeback_candidates",
    "dashboard_metrics",
    "uncertainty_notes",
    "source_context_status"
  ],
  "properties": {
    "run_date": {
      "type": "string",
      "format": "date"
    },
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "const": "Asia/Taipei"
        },
        "window_hours": {
          "type": "integer",
          "enum": [
            24,
            72
          ]
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "discernment_layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts",
        "interpretations",
        "inferences",
        "guidance"
      ],
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interpretations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inferences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "statement",
              "confidence",
              "working_hypothesis"
            ],
            "properties": {
              "statement": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "working_hypothesis": {
                "type": "boolean"
              }
            }
          }
        },
        "guidance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emotions",
        "relationship_patterns",
        "work_patterns",
        "decision_patterns"
      ],
      "properties": {
        "emotions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relationship_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "work_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "truth_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensions",
        "principles",
        "puzzles"
      ],
      "properties": {
        "dimensions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "score"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "motive",
                  "cognition",
                  "emotion",
                  "relationship",
                  "belief",
                  "evolution",
                  "causality",
                  "manifestation",
                  "suffering",
                  "freedom",
                  "compassion",
                  "discernment"
                ]
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "principles": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "title",
              "confidence"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "puzzles": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "pattern_type",
              "confidence"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "pattern_type": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "truth_observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "writeback_candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "soul_map",
        "blind_spot_archive",
        "belief_logs",
        "case_summary"
      ],
      "properties": {
        "soul_map": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recurring_patterns",
            "limiting_beliefs",
            "emotional_signatures",
            "active_lessons",
            "evolution_stage",
            "should_write"
          ],
          "properties": {
            "recurring_patterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "limiting_beliefs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "emotional_signatures": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "active_lessons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evolution_stage": {
              "type": "string"
            },
            "should_write": {
              "type": "boolean"
            }
          }
        },
        "blind_spot_archive": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "trigger_pattern",
              "known_theory",
              "practical_failure_mode",
              "suggested_anchors",
              "related_puzzles",
              "should_write"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "trigger_pattern": {
                "type": "string"
              },
              "known_theory": {
                "type": "string"
              },
              "practical_failure_mode": {
                "type": "string"
              },
              "suggested_anchors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "related_puzzles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "should_write": {
                "type": "boolean"
              }
            }
          }
        },
        "belief_logs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "belief_before",
              "belief_after",
              "tag",
              "evidence",
              "related_dimension_code",
              "related_principle_code",
              "should_write"
            ],
            "properties": {
              "belief_before": {
                "type": "string"
              },
              "belief_after": {
                "type": "string"
              },
              "tag": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "related_dimension_code": {
                "type": "string"
              },
              "related_principle_code": {
                "type": "string"
              },
              "should_write": {
                "type": "boolean"
              }
            }
          }
        },
        "case_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "summary",
            "related_dimensions",
            "should_write"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "related_dimensions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "should_write": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "dashboard_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clarity_score",
        "emotional_intensity_score",
        "alignment_score",
        "boundary_score",
        "truth_discernment_score",
        "memory_confidence_score"
      ],
      "properties": {
        "clarity_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "emotional_intensity_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "alignment_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "boundary_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "truth_discernment_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "memory_confidence_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "uncertainty_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_context_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "life_principles_attached",
        "external_context_complete",
        "missing_inputs"
      ],
      "properties": {
        "life_principles_attached": {
          "type": "boolean"
        },
        "external_context_complete": {
          "type": "boolean"
        },
        "missing_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
